# Haqdarshak AI Environment Variables Example
# Copy to .env and configure as needed

# Provider: 'mock' (default, no API key needed), 'gemini', or 'openai'
LLM_PROVIDER=mock

# API Keys (leave empty if using mock provider)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Name
LLM_MODEL_NAME=gemini-2.5-flash

# Tesseract OCR executable path for Windows (leave default if installed in standard location)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Database Path
DB_PATH=haqdarshak.db
